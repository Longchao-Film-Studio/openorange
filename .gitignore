# ============================================================
#  OpenOrange .gitignore
#  只提交源码、文档与配置；编译产物、运行期数据、日志一律排除。
# ============================================================

# ---------- Rust 编译产物 ----------
launcher/target/

# ---------- 运行目录：只提交 OpenOrange.ini ----------
launcher/dist/OO_Launcher.exe
launcher/dist/OO_Internal.dll
launcher/dist/*.pdb
launcher/dist/*.exp
launcher/dist/*.lib
launcher/dist/work/
launcher/dist/*.log
launcher/dist/*.png
launcher/dist/*.bin
launcher/dist/launcher_state.ini

# ---------- 运行期数据 ----------
shared/data.db
shared/data.db-shm
shared/data.db-wal
# 游戏服抓包目录（每次启动自动创建）
work/

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---------- 本地过程脚本（不入库）----------
archivescript/
my_scripts/

# ---------- 临时产物 ----------
*.unpacked
*.pcapng

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
